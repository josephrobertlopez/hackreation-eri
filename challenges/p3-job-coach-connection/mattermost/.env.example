# Copy to .env (git-ignored) and change the password.
MM_DB_PASSWORD=change-me
MM_PORT=8065
# Set to http://<your-LAN-IP>:8065 so links and the iPhone app resolve.
MM_SITEURL=http://localhost:8065
# Space-separated page origins allowed for live updates: laptop and iPhone URLs.
MM_ALLOWED_ORIGINS=http://localhost:8065 http://<your-LAN-IP>:8065
